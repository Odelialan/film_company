{
    "name": "film-studio",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "npm@10.9.4",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "dev:server": "node server/index.js",
        "test": "node --test server/*.test.js",
        "lint": "eslint .",
        "test:e2e": "npm run build && playwright test",
        "test:coverage": "c8 --all --include=server/**/*.js --exclude=server/*.test.js --exclude=server/admin-*.js --check-coverage --lines=50 --functions=60 --branches=50 npm test",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "start": "node server/index.js",
        "admin-user": "node server/admin-user.js"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "lucide-react": "^0.562.0",
        "nodemailer": "^9.0.3",
        "react": "^19.2.3",
        "react-dom": "^19.2.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "c8": "^12.0.0",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "sharp": "^0.35.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.3.0"
    }
}
